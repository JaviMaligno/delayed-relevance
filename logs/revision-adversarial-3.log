    61	
    62	    def _apply_state_update(self, text: str) -> None:
    63	        # Se lee UN objeto JSON completo con raw_decode. La regex no codiciosa de antes
    64	        # cortaba en la primera llave de cierre, asi que todo parche anidado -- el caso
    65	        # normal en shelf_contents -- se tiraba en silencio: 0 de 6.000 aplicados en R2.
    66	        match = re.search(r"StateUpdate:\s*(?=\{)", text)
    67	        if match is None:
    68	            return
    69	        try:
    70	            update, _ = json.JSONDecoder().raw_decode(text, match.end())
    71	        except json.JSONDecodeError:
    72	            return
    73	        if isinstance(update, dict):
    74	            # Mismo esquema fijo que el brazo de estado. Este runtime no tiene bucle de
    75	            # validacion, asi que las claves ajenas se descartan en vez de reintentarse.
    76	            allowed = {k: v for k, v in update.items() if k in self.schema_fields}
    77	            # Misma profundidad de merge que SKILL.state: si un brazo conserva las
    78	            # sub-claves hermanas y el otro no, la comparacion queda sesgada.
    79	            _merge_into(self.state, allowed, deep=self.deep_merge)
    80	
    81	    def state_size(self) -> int:
    82	        return len(json.dumps(self.state))
