    81	class Warehouse:
    82	    """Inventario discreto y determinista sobre 500 estanterias independientes.
    83	
    84	    Los eventos son registros estructurados con campos irrelevantes ademas de los
    85	    portantes. Esa densidad es deliberada: con observaciones de una linea corta, el
    86	    brazo de historia completa nunca llega a la presion de contexto donde el metodo
    87	    del paper tiene algo que ganar, y la calibracion mide otra cosa.
    88	    """
    89	
    90	    def __init__(
    91	        self,
    92	        horizon: int,
    93	        seed: int,
    94	        latent_k: int | None = None,
    95	        latent_control: bool = False,
    96	        oracle_schema: bool = False,
    97	        hatch_schema: bool = False,
    98	        reminder: bool = False,
    99	        reminder_raw: bool = False,
   100	        long_spec: bool = False,
   101	        invalidation_k: int | None = None,
   102	        apendice_b: bool = False,
   103	        sin_telemetria: bool = False,
   104	        ruido: int = 0,
   105	        latent_estricto: bool = False,
   106	    ) -> None:
   107	        """`latent_k` activa la sonda de relevancia diferida.
   108	
   109	        En el paso `t` el entorno anuncia que una estanteria queda en cuarentena. El
   110	        aviso es indistinguible del ruido de fondo y no afecta a la accion en curso.
   111	        En `t + latent_k` esa estanteria es la libre mas baja, asi que la accion
   112	        correcta es saltarsela. Quien perdio el aviso almacena ahi y falla.
   113	
   114	        `latent_control=True` pone en cuarentena una estanteria que nunca llega a ser
   115	        la libre mas baja: el aviso llega igual pero nunca es portante. Todos los
   116	        runtimes deben puntuar igual que sin sonda; si no, el efecto medido no es la
   117	        relevancia diferida sino la presencia del aviso.
   118	        """
   119	        self.horizon = horizon
   120	        self.seed = seed
   121	        self.latent_k = latent_k
   122	        # Revision adversarial 6: el generador no comprobaba que el hecho no importara
   123	        # antes de t+k, y en la mayoria de las seeds importaba a los 5-8 pasos. En modo
   124	        # estricto solo se acepta un escenario si, con la politica correcta y el aviso
   125	        # ya colocado, el hecho cambia la accion por PRIMERA vez justo en t+k. Por
   126	        # defecto desactivado: lo ya medido no se mueve.
   127	        self.latent_estricto = latent_estricto
   128	        self.latent_control = latent_control
   129	        self.oracle_schema = oracle_schema
   130	        self.hatch_schema = hatch_schema
   131	        self.reminder = reminder
   132	        # `reminder_raw` repite el aviso ENTERO, tal como llego, en vez de los tres
   133	        # campos portantes. Separa dos explicaciones del efecto del recordatorio que
   134	        # hasta ahora iban juntas: si basta con que el hecho este disponible, o si hace
   135	        # falta ademas que este destilado. El aviso original ya dice `do_not_store=true`,
   136	        # asi que la diferencia entre las dos condiciones no es la instruccion: es que
   137	        # una trae 3 campos y la otra los mismos 3 enterrados entre otros quince.
   138	        self.reminder_raw = reminder_raw
   139	        # `long_spec` anade la referencia de campos, las excepciones y los ejemplos
   140	        # resueltos, que llevan el procedimiento por encima del prefijo minimo
   141	        # cacheable (4.096 tokens, medidos). Sin eso la tabla de coste solo mide el
   142	        # caso en que NADA cachea salvo la historia acumulada de ReAct.
   143	        self.long_spec = long_spec
   144	        self.quarantine_notice_text: str | None = None
   145	        # `apendice_b` cierra los dos huecos que I4 encontro contra su Apendice B:
   146	        # los eventos de mantenimiento que obligan a `Move`, y el rechazo de acciones
   147	        # invalidas con observacion de error local. Va detras de bandera porque
   148	        # cambiarlo por debajo invalidaria los 100 episodios de R1 de golpe; con
   149	        # bandera, la diferencia entre las dos variantes ES la medida del hueco.
   150	        self.apendice_b = apendice_b
   151	        # Hueco 3 de I4. Su Algoritmo 2 no tiene familia no accionable: `Receive`
   152	        # siempre, y `Order`/`Maintenance` en cuanto hay stock. Nuestra telemetria es
   153	        # un paso propio, asi que un tercio de nuestra historia no muta el estado: el
   154	        # transcript crece igual pero hay menos que recordar.
   155	        self.sin_telemetria = sin_telemetria
   156	        # Su ruido del Apendice C es otra cosa y va en su sitio: anexado a la
   157	        # observacion de un evento real, bajo su cabecera, y sin tocar el estado.
   158	        self.ruido = ruido
   159	        self.rechazo: tuple[int, str] | None = None
   160	        self.invalidation_k = invalidation_k
   161	        self.invalidation_from: int | None = None
   162	        self.invalidated_shelf: int | None = None
   163	        self.shelves: dict[int, tuple[str, int, str] | None] = {i: None for i in range(SHELF_COUNT)}
   164	        self.step_index = 0
   165	        self.quarantined_shelf: int | None = None
   166	        self.quarantine_from: int | None = None
   167	        self.dependent_step: int | None = None
   168	        self.script: list[Observation] = self._build_script()
   169	        if latent_k is not None:
   170	            self._plant_latent_rule(latent_k)
   171	        if invalidation_k is not None:
   172	            self._plant_invalidation(invalidation_k)
   173	
   174	    def _canonical_first_empty(self) -> list[tuple[int, int]]:
   175	        """Simula la trayectoria del oraculo y devuelve (paso, estanteria libre mas baja)
   176	        para cada evento de entrada. Sirve para elegir donde plantar la regla latente."""
   177	        ocupadas: dict[int, str] = {}
   178	        puntos: list[tuple[int, int]] = []
   179	
   180	        def primera_libre() -> int:
   181	            i = 0
   182	            while i in ocupadas:
   183	                i += 1
   184	            return i
   185	
   186	        for paso, obs in enumerate(self.script):
   187	            if "inbound_pallet" in obs.text:
   188	                libre = primera_libre()
   189	                puntos.append((paso, libre))
   190	                ocupadas[libre] = event_field(obs.text, "sku") or ""
   191	            elif "outbound_order" in obs.text:
   192	                sku = event_field(obs.text, "sku") or ""
   193	                for i in sorted(ocupadas):
   194	                    if ocupadas[i] == sku:
   195	                        del ocupadas[i]
   196	                        break
   197	        return puntos
   198	
   199	    def _plant_latent_rule(self, k: int) -> None:
   200	        candidatos = [(p, s) for p, s in self._canonical_first_empty() if p - k >= 0]
   201	        if not candidatos:
   202	            raise ValueError(f"horizonte {self.horizon} demasiado corto para k={k}")
   203	        # El mas tardio deja el maximo de historia antes del aviso.
   204	        if self.latent_estricto:
   205	            elegido = next((c for c in reversed(candidatos) if self._escenario_limpio(c, k)), None)
   206	            if elegido is None:
   207	                raise ValueError(f"seed {self.seed}: ningun escenario donde el hecho importe "
   208	                                 f"por primera vez justo en t+{k}")
   209	            paso_dependiente, estanteria = elegido
   210	        else:
   211	            paso_dependiente, estanteria = candidatos[-1]
   212	        self._plantar_aviso(paso_dependiente, estanteria, k)
   213	
   214	    def _escenario_limpio(self, candidato: tuple[int, int], k: int) -> bool:
   215	        """Con el aviso ya colocado (sustituye al evento de su paso), la politica
   216	        correcta ve cambiar su accion por la cuarentena por primera vez en t+k."""
   217	        import copy
   218	        prueba = copy.deepcopy(self)
   219	        prueba._plantar_aviso(candidato[0], candidato[1], k)
   220	        prueba.reset()
   221	        while not prueba.done:
   222	            prueba.observe()
   223	            sin = copy.deepcopy(prueba)
   224	            sin.quarantined_shelf = None
   225	            if prueba.expected_action().render() != sin.expected_action().render():
   226	                return prueba.step_index == candidato[0]
   227	            prueba.apply(prueba.expected_action())
   228	        return False
   229	
   230	    def _plantar_aviso(self, paso_dependiente: int, estanteria: int, k: int) -> None:
   231	        paso_aviso = paso_dependiente - k
   232	        self.dependent_step = paso_dependiente
   233	        self.quarantine_from = paso_aviso
   234	        # En la condicion de control la cuarentena cae sobre una estanteria que nunca
   235	        # llega a ser la libre mas baja, asi que el aviso nunca es portante.
   236	        self.quarantined_shelf = SHELF_COUNT - 1 if self.latent_control else estanteria
   237	        rng = random.Random(self.seed * 7919 + k)
   238	        self.script[paso_aviso] = Observation(
   239	            step=paso_aviso,
   240	            text=(
   241	                f"EVENT facility_notice | notice_id=FAC-{rng.randint(1000, 9999)} "
   242	                f"| shelf={self.quarantined_shelf} | status=quarantined "
   243	                f"| reason=scheduled_maintenance | effective=immediately "
   244	                f"| do_not_store=true | expires=none\n"
   245	                f"  raised_by=facilities_{rng.randint(100, 999)} "
   246	                f"| work_order=WO-{rng.randint(10000, 99999)} "
   247	                f"| contractor={rng.choice(CARRIERS)} "
   248	                f"| estimated_duration_days={rng.randint(3, 30)} "
   249	                f"| access_restricted=true | signage_posted=true"
   250	                + _audit_block(rng)
   251	            ),
   252	            actionable=False,
   253	        )
   254	        self.quarantine_notice_text = self.script[paso_aviso].text
   255	
   256	    def _plant_invalidation(self, k: int) -> None:
   257	        """Sonda C: invalidacion retroactiva, con metrica de PROMEDIO y no de evento.
   258	
   259	        En el paso `t` el agente almacena en la estanteria S. En `t+k` llega un aviso
   260	        de que aquella colocacion nunca se completo y S esta en realidad vacia. Desde
   261	        ese momento S es la libre mas baja, asi que **todos** los `Store` posteriores
   262	        dependen de haber aplicado la correccion, no solo el siguiente.
   263	
   264	        Esa eleccion es deliberada: la misma pregunta formulada como "acerto el paso
   265	        siguiente" tiene ~50 puntos de ruido de muestreo; formulada como score sobre
   266	        el tramo posterior promedia quince o veinte eventos y el ruido casi desaparece.
   267	        Ademas mide mejor lo que interesa: no si se recupero una vez, sino si SIGUIO
   268	        recuperado.
   269	        """
   270	        puntos = self._canonical_first_empty()
   271	        candidatos = [(p, s) for p, s in puntos if p + k < self.horizon - 4]
   272	        if not candidatos:
   273	            raise ValueError(f"horizonte {self.horizon} demasiado corto para invalidacion k={k}")
   274	        paso_store, estanteria = candidatos[0]
   275	        self.invalidated_shelf = estanteria
   276	        self.invalidation_from = paso_store + k
   277	        rng = random.Random(self.seed * 6271 + k)
   278	        self.script[self.invalidation_from] = Observation(
   279	            step=self.invalidation_from,
   280	            text=(
   281	                f"EVENT correction_notice | notice_id=COR-{rng.randint(1000, 9999)} "
   282	                f"| corrects_step={paso_store} | shelf={estanteria} "
   283	                f"| finding=putaway_never_completed | shelf_is_now=empty "
   284	                f"| stock_removed=true | confidence=confirmed\n"
   285	                f"  raised_by=cycle_count_team_{rng.randint(10, 99)} "
   286	                f"| audit_ref=AUD-{rng.randint(10000, 99999)} "
   287	                f"| recount_performed=true | discrepancy_closed=true "
   288	                f"| supersedes_prior_record=true"
   289	                + _audit_block(rng)
   290	            ),
   291	            actionable=False,
   292	        )
   293	
   294	    def _apply_invalidation_if_due(self) -> None:
   295	        """Al llegar el aviso, el estado VERDADERO cambia: la estanteria queda vacia."""
   296	        if (
   297	            self.invalidation_from is not None
   298	            and self.invalidated_shelf is not None
   299	            and self.step_index == self.invalidation_from
   300	        ):

