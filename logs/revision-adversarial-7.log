    72	def event_field(text: str, name: str) -> str | None:
    73	    """Lee un campo `clave=valor` de un registro de evento."""
    74	    for chunk in text.split(" | "):
    75	        key, _, value = chunk.partition("=")
    76	        if key.strip() == name:
    77	            return value.strip()
    78	    return None
