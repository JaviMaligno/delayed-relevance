    50	def adjudicar(fichero: Path) -> dict:
    51	    filas = [json.loads(l) for l in fichero.read_text(encoding="utf-8").splitlines()
    52	             if l.strip()]
    53	    cabecera = next((f["condiciones"] for f in filas if f.get("kind") == "run_header"), {})
    54	    pasos = [f for f in filas if f.get("kind") != "run_header"]
    55	    env = Warehouse(horizon=len(pasos), seed=cabecera["seed"],
    56	                    apendice_b=cabecera.get("apendice_b", False),
    57	                    sin_telemetria=cabecera.get("sin_telemetria", False),
    58	                    ruido=cabecera.get("ruido", 0))
    59	    env.reset()
    60	    campos = set(env.schema_fields())
    61	    estado: dict = {}
    62	    # Stateful escribe `StateUpdate: {...}` y no reintenta; se aplica con su propio
    63	    # parser para reproducir exactamente el estado que vio el modelo.
    64	    stateful = (StatefulRuntime(client=None, spec="", schema_fields=sorted(campos))
    65	                if cabecera.get("runtime") == "stateful" else None)
    66	    origen = None
    67	    clases = {"estado_heredado": 0, "accion_con_estado_correcto": 0}
    68	    for paso in pasos:
    69	        env.observe()
    70	        bien_antes = _coincide(_creencia(estado), _realidad(env))
    71	        if paso.get("actionable") and not paso.get("correct"):
    72	            clases["estado_heredado" if not bien_antes else "accion_con_estado_correcto"] += 1
    73	        if stateful is not None:
    74	            stateful._apply_state_update(paso["raw"]["respuestas"][-1])
    75	            estado = stateful.state
    76	        else:
    77	            for respuesta in paso["raw"]["respuestas"]:
    78	                leido = SkillStateRuntime._parse(respuesta)
    79	                if leido is not None and all(k in campos for k in leido[0]):
    80	                    _merge_into(estado, leido[0], deep=True)
    81	                    break
    82	        accion = Action.parse(paso["ejecutado"]) if paso.get("ejecutado") else None
    83	        env.apply(accion if accion is not None else NO_OP)
    84	        if origen is None and bien_antes and not _coincide(_creencia(estado), _realidad(env)):
    85	            origen = {"paso": paso["step"], "accion_correcta": paso.get("correct"),
    86	                      "esperado": paso.get("esperado"), "ejecutado": paso.get("ejecutado")}
    87	    return {"fichero": fichero.name, "clases": clases, "origen": origen}
