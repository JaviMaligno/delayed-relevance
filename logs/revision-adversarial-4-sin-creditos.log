   126	def adjudicar(fichero: Path, por_defecto: dict | None = None) -> dict:
   127	    filas = [json.loads(l) for l in fichero.read_text(encoding="utf-8").splitlines()
   128	             if l.strip()]
   129	    cabecera = next((f["condiciones"] for f in filas if f.get("kind") == "run_header"), None)
   130	    if cabecera is None:
   131	        if por_defecto is None:
   132	            raise SystemExit(f"{fichero.name}: sin cabecera de condiciones; pasa "
   133	                             "--condiciones con las de su corrida en vez de suponerlas")
   134	        cabecera = dict(por_defecto)
   135	        cabecera.setdefault("seed", int(re.search(r"_s(\d+)_", fichero.name).group(1)))
   136	        cabecera.setdefault("runtime", re.search(r"_(react|memory|stateful|skillstate)_",
   137	                                                 fichero.name).group(1))
   138	    pasos = [f for f in filas if f.get("kind") != "run_header"]
   139	    env = Warehouse(horizon=len(pasos), seed=cabecera["seed"],
   140	                    apendice_b=cabecera.get("apendice_b", False),
   141	                    sin_telemetria=cabecera.get("sin_telemetria", False),
   142	                    ruido=cabecera.get("ruido", 0))
   143	    env.reset()
   144	    campos = set(env.schema_fields())
   145	    stateful = cabecera.get("runtime") == "stateful"
   146	    version = cabecera.get("stateful_parser") or 1
   147	    estado: dict = {}
   148	    origen = None
   149	    clases = {"estado_causa": 0, "estado_discrepante_sin_efecto": 0, "estado_correcto": 0}
   150	    for paso in pasos:
   151	        env.observe()
   152	        creencia, realidad = _creencia(estado), _realidad(env)
   153	        bien_antes = _coincide(creencia, realidad)
   154	        if paso.get("actionable") and not paso.get("correct"):
   155	            if bien_antes:
   156	                clases["estado_correcto"] += 1
   157	            else:
   158	                segun_creencia = _prescrita_por(env, creencia)
   159	                if (segun_creencia != env.expected_action().render()
   160	                        and paso.get("ejecutado") == segun_creencia):
   161	                    clases["estado_causa"] += 1
   162	                else:
   163	                    clases["estado_discrepante_sin_efecto"] += 1
   164	        if stateful:
   165	            estado = _aplicar_stateful(version, estado, paso["raw"]["respuestas"][-1], campos)
   166	        else:
   167	            for respuesta in paso["raw"]["respuestas"]:
   168	                leido = SkillStateRuntime._parse(respuesta)
   169	                if leido is not None and all(k in campos for k in leido[0]):
   170	                    _merge_into(estado, leido[0], deep=True)
   171	                    break
   172	        accion = Action.parse(paso["ejecutado"]) if paso.get("ejecutado") else None
   173	        env.apply(accion if accion is not None else NO_OP)
   174	        if origen is None and bien_antes and not _coincide(_creencia(estado), _realidad(env)):
   175	            origen = {"paso": paso["step"], "accion_correcta": paso.get("correct"),
   176	                      "esperado": paso.get("esperado"), "ejecutado": paso.get("ejecutado")}
   177	    return {"fichero": fichero.name, "clases": clases, "origen": origen}
   178	
   179	
   180	def main() -> None:
   181	    p = argparse.ArgumentParser()
   182	    p.add_argument("patron", help="glob de trazas, p. ej. 'results/adj_T200_*_skillstate_*_h?.jsonl'")
   183	    p.add_argument("--condiciones", default=None,
   184	                   help="JSON con las condiciones de trazas SIN cabecera, p. ej. "
   185	                        '\'{"apendice_b": true, "sin_telemetria": true}\'. Sin esto, una '
   186	                        "traza sin cabecera es un error: no se suponen condiciones.")
   187	    args = p.parse_args()
   188	    por_defecto = json.loads(args.condiciones) if args.condiciones else None
   189	    total = {"estado_causa": 0, "estado_discrepante_sin_efecto": 0, "estado_correcto": 0}
   190	    origenes = {"parche_mal_con_accion_bien": 0, "accion_mal": 0}
