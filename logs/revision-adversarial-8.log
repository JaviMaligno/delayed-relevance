    50	    sin_cachear = sum(r.prompt_tokens for r in results)
    51	    leidos = sum(r.cache_read for r in results)
    52	    escritos = sum(r.cache_write for r in results)
    53	    brutos = sin_cachear + leidos + escritos
    54	    efectivo = sin_cachear + leidos * PRECIO_CACHE_LECTURA + escritos * PRECIO_CACHE_ESCRITURA
