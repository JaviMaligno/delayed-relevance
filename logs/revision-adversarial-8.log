    39	def coste_efectivo(results: list[StepResult]) -> dict[str, float]:
    40	    """Tokens de entrada equivalentes a precio completo, con y sin cache.
    41	
    42	    El paper compara TOKENS; quien paga la factura compara DINERO. Un transcript
    43	    append-only cachea casi entero y se cobra a 0.1x, mientras un bloque de estado
    44	    que muta invalida la cache y se cobra completo. Medir solo tokens brutos
    45	    sobreestima la ventaja del estado explicito.
    46	    """
    47	    # `input_tokens` de la API NO incluye los cacheados: los reporta aparte. La entrada
    48	    # total es la suma de los tres. Restar el cache de `input_tokens` da coste negativo,
