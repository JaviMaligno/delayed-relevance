        patch,kind=decode_patch(raw,3)
        if isinstance(patch,dict):_merge_into(independent,{k:v for k,v in patch.items() if k in ('\\''shelf_contents'\\'','\\''last_event'\\'')},deep=True)
        co['\\''state_replay_comparisons'\\'']+=1;co['\\''state_replay_mismatches'\\'']+=runtime.state"'!=independent
print(dict(co))
