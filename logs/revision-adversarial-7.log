        world[v['shelf']]=(str(v.get('sku')),int(v.get('units') or 0),str(v.get('lot')))
    elif a.name=='Ship' and isinstance(v.get('shelf'),int) and 0<=v['shelf']<500:
        world.pop(v['shelf'],None)
    elif a.name=='Move':
        s,t=v.get('from'),v.get('to')
        if isinstance(s,int) and isinstance(t,int) and 0<=s<500 and 0<=t<500 and s in world and t not in world:
            world[t]=world.pop(s)
