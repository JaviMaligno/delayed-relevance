    67	    def _cola(self, observation: Observation) -> str:
    68	        return (
    69	            f"Latest Observation: {observation.render()}\n"
    70	            "Update the state if necessary, provide reasoning, and output 'Action: <cmd>'.\n"
    71	            'To update state, use the format: StateUpdate: {"key": "value"}\n'
    72	            f"Patch semantics: {self._merge_doc()}"
    73	        )
    74	
    75	    def _act_con_cache(self, observation: Observation) -> tuple[Action | None, list[Completion]]:
    76	        """Mismo contenido que `act`, con la historia en bloques inmutables marcados como
    77	        prefijo cacheable. Con `estado_primero` el bloque de estado encabeza el prefijo y
    78	        muta en cada paso; con `historia_primero` va detras, fuera del prefijo."""
    79	        estado = (f"Current State:\n{json.dumps(self.state, indent=2)}\n"
    80	                  f"State schema (only these keys are valid): {', '.join(self.schema_fields)}\n\n")
    81	        historia = ["History:\n"] + [linea + "\n" for linea in self.history]
    82	        if self.orden == "historia_primero":
    83	            prefijo, user = historia, "\n" + estado + self._cola(observation)
    84	        else:
    85	            prefijo, user = [estado] + historia, "\n" + self._cola(observation)
    86	        completion = self.client.complete(system=f"Instructions:\n{self.spec}", user=user,
    87	                                          cache_prefix=prefijo)
    88	        self._apply_state_update(completion.text)
    89	        self.history.append(f"Observation: {observation.render()}")
    90	        self.history.append(f"Response: {completion.text}")
    91	        return Action.parse(completion.text), [completion]
    92	
    93	    def _merge_doc(self) -> str:
    94	        if self.deep_merge:
    95	            return (
    96	                "your update is merged key by key, descending into nested objects, so "
    97	                "you may send only the sub-keys that changed."
    98	            )
    99	        return (
   100	            "your update replaces each top-level key outright, so any nested object you "
   101	            "send must be COMPLETE - omitted sub-keys are lost."
   102	        )
   103	
   104	    def _apply_state_update(self, text: str) -> None:
   105	        # Se lee UN objeto JSON completo con raw_decode. La regex no codiciosa de antes
   106	        # cortaba en la primera llave de cierre, asi que todo parche anidado -- el caso
   107	        # normal en shelf_contents -- se tiraba en silencio: 0 de 6.000 aplicados en R2.
   108	        # v3: entre la etiqueta y la llave puede haber dos puntos, negritas y un bloque
   109	        # de codigo (`**StateUpdate:**` + ```json), que es como lo escribe Haiku.
   110	        match = re.search(r"StateUpdate[\s*:]*(?:```(?:json)?[ \t]*\n?)?\s*(?=\{)", text)
   111	        if match is None:
   112	            return
   113	        try:
   114	            update, _ = json.JSONDecoder().raw_decode(text, match.end())
   115	        except json.JSONDecodeError:
   116	            return
   117	        if isinstance(update, dict):
   118	            # Mismo esquema fijo que el brazo de estado. Este runtime no tiene bucle de
   119	            # validacion, asi que las claves ajenas se descartan en vez de reintentarse.
   120	            allowed = {k: v for k, v in update.items() if k in self.schema_fields}
   121	            # Misma profundidad de merge que SKILL.state: si un brazo conserva las
   122	            # sub-claves hermanas y el otro no, la comparacion queda sesgada.
   123	            _merge_into(self.state, allowed, deep=self.deep_merge)
   124	
   125	    def state_size(self) -> int:
   126	        return len(json.dumps(self.state))

