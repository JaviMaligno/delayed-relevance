   103	def _coincide_estante(creido, real) -> bool:
   104	    if creido is None or real is None:
   105	        return creido is real
   106	    # Los campos que el modelo no especifico no cuentan como discrepancia.
   107	    return all(c is None or c == r for c, r in zip(creido, real))
