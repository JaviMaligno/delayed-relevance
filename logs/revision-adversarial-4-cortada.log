   101	    def _apply_state_update(self, text: str) -> None:
   102	        # Se lee UN objeto JSON completo con raw_decode. La regex no codiciosa de antes
   103	        # cortaba en la primera llave de cierre, asi que todo parche anidado -- el caso
   104	        # normal en shelf_contents -- se tiraba en silencio: 0 de 6.000 aplicados en R2.
   105	        # v3: entre la etiqueta y la llave puede haber dos puntos, negritas y un bloque
   106	        # de codigo (`**StateUpdate:**` + ```json), que es como lo escribe Haiku.
   107	        match = re.search(r"StateUpdate[\s*:]*(?:```(?:json)?[ \t]*\n?)?\s*(?=\{)", text)
   108	        if match is None:
   109	            return
   110	        try:
   111	            update, _ = json.JSONDecoder().raw_decode(text, match.end())
   112	        except json.JSONDecodeError:
   113	            return
   114	        if isinstance(update, dict):
   115	            # Mismo esquema fijo que el brazo de estado. Este runtime no tiene bucle de
   116	            # validacion, asi que las claves ajenas se descartan en vez de reintentarse.
   117	            allowed = {k: v for k, v in update.items() if k in self.schema_fields}
   118	            # Misma profundidad de merge que SKILL.state: si un brazo conserva las
   119	            # sub-claves hermanas y el otro no, la comparacion queda sesgada.
   120	            _merge_into(self.state, allowed, deep=self.deep_merge)
   121	
