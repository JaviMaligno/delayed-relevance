+            raise http.client.RemoteDisconnected("Remote end closed connection without response")
+        return vertex["respuesta"]
+
+    monkeypatch.setattr(llm, "post_json", _post)
+    monkeypatch.setattr(llm.time, "sleep", lambda _s: None)
