def welch(a,b):
    d=statistics.mean(a)-statistics.mean(b); x=statistics.variance(a)/len(a); y=statistics.variance(b)/len(b)
    se=math.sqrt(x+y); df=(x+y)**2/(x*x/(len(a)-1)+y*y/(len(b)-1))
