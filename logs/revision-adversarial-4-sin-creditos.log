   204	    print(f"\nepisodios: {episodios}")
   205	    print("fallos:", total)
   206	    print("episodios cuya creencia se aparto de la realidad, por su origen:", origenes)
   207	    print("episodios con al menos un fallo causado por el estado:", con_efecto)
