            counts[cat]+=1
        if h['\\''runtime'\\'']=='\\''stateful'\\'':
            patch,kind=decode_patch(r['\\''raw'\\'']['\\''respuestas'\\''][-1],h.get('\\''stateful_parser'\\'') or 1)
            counts['\\''patch_'\\''+kind]+=1
            if isinstance(patch,dict):_merge_into(st,{k:v for k,v in patch.items() if k in env.schema_fields()},deep=True)
