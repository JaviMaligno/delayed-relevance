    66	def episodio(cliente, seed: int, k: int, runtime: str) -> dict:
    67	    env = Warehouse(horizon=50, seed=seed, invalidation_k=k)
    68	    rt = RUNTIMES[runtime](cliente, env)
    69	    env.reset()
    70	    # La creencia se congela ANTES de que el aviso vacie la estanteria y a partir de
    71	    # ahi solo la mueven las acciones del propio agente: es su mundo si no oyo nada.
    72	    creencia = dict(env.shelves)
    73	    cajas = {"correcta": 0, "sorda": 0, "otra": 0}
    74	    truncadas = sin_accion = pasos = 0
    75	    efectiva = salida = 0.0
    76	    while not env.done:
    77	        obs = env.observe()
    78	        esperada = env.expected_action()
    79	        sorda = accion_sorda(obs, creencia)
    80	        accion, completions = rt.act(obs)
    81	        pasos += 1
    82	        truncadas += sum(1 for c in completions if c.truncated)
    83	        efectiva += sum(c.prompt_tokens + c.cache_read * 0.10
    84	                        + c.cache_write * 1.25 for c in completions)
    85	        salida += sum(c.output_tokens for c in completions)
    86	        sin_accion += accion is None
    87	        posterior = (env.invalidation_from is not None
    88	                     and env.step_index > env.invalidation_from)
    89	        if posterior and obs.actionable:
    90	            rend = accion.render() if accion is not None else None
    91	            if rend == esperada.render():
    92	                cajas["correcta"] += 1
    93	            elif rend == sorda.render():
    94	                cajas["sorda"] += 1
    95	            else:
    96	                cajas["otra"] += 1
    97	        actualiza(creencia, accion if accion is not None else esperada)
    98	        env.apply(accion if accion is not None else esperada)
    99	    n = sum(cajas.values())
   100	    return {**cajas, "n_posteriores": n,
   101	            "score_posterior": cajas["correcta"] / n if n else 0.0,
   102	            "truncadas": truncadas, "sin_accion": sin_accion, "pasos": pasos,
   103	            "entrada_efectiva": efectiva, "salida": salida,
   104	            "parches_invalidos": getattr(rt, "invalid_patches", 0)}
